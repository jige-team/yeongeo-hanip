[
  {"id": "m01", "set": "work", "en": "Could you share your screen?", "ko": "화면 공유해 주실 수 있나요?", "chunk": "share your screen", "chunkKo": "화면을 공유하다"},
  {"id": "m02", "set": "work", "en": "Let's circle back to this later.", "ko": "이건 나중에 다시 얘기해요.", "chunk": "circle back", "chunkKo": "나중에 다시 다루다"},
  {"id": "m03", "set": "work", "en": "Can we push the meeting to Friday?", "ko": "회의를 금요일로 미룰 수 있을까요?", "chunk": "push the meeting", "chunkKo": "회의를 미루다"},
  {"id": "m04", "set": "work", "en": "I'll send you the file by tomorrow.", "ko": "내일까지 파일 보내 드릴게요.", "chunk": "by tomorrow", "chunkKo": "내일까지"},
  {"id": "m05", "set": "work", "en": "Sorry, you're on mute.", "ko": "죄송한데 음소거 상태세요.", "chunk": "on mute", "chunkKo": "음소거 상태인"},
  {"id": "m06", "set": "work", "en": "Could you say that again more slowly?", "ko": "조금 천천히 다시 말씀해 주시겠어요?", "chunk": "more slowly", "chunkKo": "더 천천히"},
  {"id": "m07", "set": "work", "en": "Let me walk you through the numbers.", "ko": "수치를 하나씩 설명드릴게요.", "chunk": "walk you through", "chunkKo": "하나씩 설명하다"},
  {"id": "m08", "set": "work", "en": "That's a good point.", "ko": "좋은 지적이에요.", "chunk": "a good point", "chunkKo": "좋은 지적"},
  {"id": "m09", "set": "work", "en": "We're running out of time.", "ko": "시간이 얼마 안 남았어요.", "chunk": "running out of time", "chunkKo": "시간이 부족해지다"},
  {"id": "m10", "set": "work", "en": "Let's wrap up for today.", "ko": "오늘은 여기서 마무리하죠.", "chunk": "wrap up", "chunkKo": "마무리하다"},
  {"id": "m11", "set": "work", "en": "I'll follow up by email.", "ko": "이메일로 후속 연락 드릴게요.", "chunk": "follow up", "chunkKo": "후속 연락하다"},
  {"id": "m12", "set": "work", "en": "What's the deadline for this?", "ko": "이거 마감이 언제예요?", "chunk": "the deadline", "chunkKo": "마감일"},
  {"id": "m13", "set": "work", "en": "Can you give me a quick update?", "ko": "간단하게 진행 상황 알려 주실래요?", "chunk": "a quick update", "chunkKo": "간단한 진행 상황"},
  {"id": "m14", "set": "work", "en": "I need a little more time on this.", "ko": "이건 시간이 조금 더 필요해요.", "chunk": "more time", "chunkKo": "시간이 더"},
  {"id": "m15", "set": "work", "en": "Let's take this offline.", "ko": "이건 회의 끝나고 따로 얘기해요.", "chunk": "take this offline", "chunkKo": "따로 얘기하다"},
  {"id": "m16", "set": "work", "en": "Are we all on the same page?", "ko": "다들 같은 생각이시죠?", "chunk": "on the same page", "chunkKo": "같은 생각인"},
  {"id": "m17", "set": "work", "en": "I'd like to add something here.", "ko": "여기에 하나 덧붙이고 싶어요.", "chunk": "add something", "chunkKo": "하나 덧붙이다"},
  {"id": "m18", "set": "work", "en": "Could you clarify what you mean?", "ko": "무슨 뜻인지 조금 더 설명해 주시겠어요?", "chunk": "clarify what you mean", "chunkKo": "무슨 뜻인지 설명하다"},
  {"id": "m19", "set": "work", "en": "Let's set up a follow-up meeting.", "ko": "후속 회의를 잡읍시다.", "chunk": "follow-up meeting", "chunkKo": "후속 회의"},
  {"id": "m20", "set": "work", "en": "I'm afraid I have to disagree.", "ko": "죄송하지만 동의하기 어려워요.", "chunk": "have to disagree", "chunkKo": "동의하기 어렵다"},
  {"id": "m21", "set": "work", "en": "Let me check and get back to you.", "ko": "확인하고 다시 연락드릴게요.", "chunk": "get back to you", "chunkKo": "다시 연락하다"},
  {"id": "m22", "set": "work", "en": "Who is in charge of this task?", "ko": "이 업무 담당자가 누구예요?", "chunk": "in charge of", "chunkKo": "~을 담당하는"},
  {"id": "m23", "set": "work", "en": "We need to cut the budget.", "ko": "예산을 줄여야 해요.", "chunk": "cut the budget", "chunkKo": "예산을 줄이다"},
  {"id": "m24", "set": "work", "en": "Let's keep it short today.", "ko": "오늘은 짧게 끝내죠.", "chunk": "keep it short", "chunkKo": "짧게 하다"},
  {"id": "m25", "set": "work", "en": "Thanks for joining the call.", "ko": "통화에 참여해 주셔서 감사해요.", "chunk": "joining the call", "chunkKo": "통화에 참여하기"},
  {"id": "m26", "set": "work", "en": "Can you hear me clearly?", "ko": "제 목소리 잘 들리세요?", "chunk": "hear me clearly", "chunkKo": "내 말이 잘 들리다"},
  {"id": "m27", "set": "work", "en": "I'll share the slides after the meeting.", "ko": "회의 끝나고 슬라이드 공유할게요.", "chunk": "share the slides", "chunkKo": "슬라이드를 공유하다"},
  {"id": "m28", "set": "work", "en": "Let's move on to the next item.", "ko": "다음 안건으로 넘어가죠.", "chunk": "move on", "chunkKo": "넘어가다"},
  {"id": "m29", "set": "work", "en": "That works for me.", "ko": "저는 좋아요.", "chunk": "works for me", "chunkKo": "나는 괜찮다"},
  {"id": "m30", "set": "work", "en": "Let's touch base next week.", "ko": "다음 주에 다시 이야기 나눠요.", "chunk": "touch base", "chunkKo": "잠깐 연락하다"},
  {"id": "d01", "set": "daily", "en": "Can I get this to go?", "ko": "이거 포장해 주실 수 있나요?", "chunk": "to go", "chunkKo": "포장으로"},
  {"id": "d02", "set": "daily", "en": "Could I get the check, please?", "ko": "계산서 주시겠어요?", "chunk": "get the check", "chunkKo": "계산서를 받다"},
  {"id": "d03", "set": "daily", "en": "Is this seat taken?", "ko": "이 자리 주인 있나요?", "chunk": "seat taken", "chunkKo": "자리가 찬"},
  {"id": "d04", "set": "daily", "en": "I'm just looking, thanks.", "ko": "그냥 구경하는 중이에요, 감사해요.", "chunk": "just looking", "chunkKo": "그냥 구경하는"},
  {"id": "d05", "set": "daily", "en": "Do you have this in a smaller size?", "ko": "이거 더 작은 사이즈 있나요?", "chunk": "smaller size", "chunkKo": "더 작은 사이즈"},
  {"id": "d06", "set": "daily", "en": "Can you recommend something?", "ko": "추천해 주실 만한 거 있나요?", "chunk": "recommend something", "chunkKo": "뭔가를 추천하다"},
  {"id": "d07", "set": "daily", "en": "Sorry, I'm running late.", "ko": "미안해요, 좀 늦을 것 같아요.", "chunk": "running late", "chunkKo": "늦어지다"},
  {"id": "d08", "set": "daily", "en": "Let's grab a coffee sometime.", "ko": "언제 커피 한잔해요.", "chunk": "grab a coffee", "chunkKo": "커피 한잔하다"},
  {"id": "d09", "set": "daily", "en": "What do you feel like eating?", "ko": "뭐 먹고 싶어요?", "chunk": "feel like eating", "chunkKo": "먹고 싶다"},
  {"id": "d10", "set": "daily", "en": "It's on me today.", "ko": "오늘은 제가 살게요.", "chunk": "on me", "chunkKo": "내가 낸다"},
  {"id": "d11", "set": "daily", "en": "Could you take a picture of us?", "ko": "저희 사진 좀 찍어 주실래요?", "chunk": "take a picture", "chunkKo": "사진을 찍다"},
  {"id": "d12", "set": "daily", "en": "How long does it take to get there?", "ko": "거기까지 얼마나 걸려요?", "chunk": "how long", "chunkKo": "얼마나 오래"},
  {"id": "d13", "set": "daily", "en": "I'll be there in ten minutes.", "ko": "10분 안에 도착해요.", "chunk": "ten minutes", "chunkKo": "10분"},
  {"id": "d14", "set": "daily", "en": "Do you mind if I sit here?", "ko": "여기 앉아도 될까요?", "chunk": "do you mind", "chunkKo": "괜찮으세요?"},
  {"id": "d15", "set": "daily", "en": "Can I pay by card?", "ko": "카드로 결제할 수 있나요?", "chunk": "pay by card", "chunkKo": "카드로 결제하다"},
  {"id": "d16", "set": "daily", "en": "Where is the restroom?", "ko": "화장실이 어디예요?", "chunk": "the restroom", "chunkKo": "화장실"},
  {"id": "d17", "set": "daily", "en": "I'd like a table for two.", "ko": "두 명 자리 부탁해요.", "chunk": "table for two", "chunkKo": "두 명 자리"},
  {"id": "d18", "set": "daily", "en": "That sounds great.", "ko": "좋은 생각이에요.", "chunk": "sounds great", "chunkKo": "좋게 들린다"},
  {"id": "d19", "set": "daily", "en": "Let me think about it.", "ko": "생각 좀 해 볼게요.", "chunk": "think about it", "chunkKo": "생각해 보다"},
  {"id": "d20", "set": "daily", "en": "Sorry, I didn't catch that.", "ko": "죄송해요, 잘 못 들었어요.", "chunk": "catch that", "chunkKo": "알아듣다"},
  {"id": "d21", "set": "daily", "en": "Have a good weekend.", "ko": "주말 잘 보내요.", "chunk": "good weekend", "chunkKo": "좋은 주말"},
  {"id": "d22", "set": "daily", "en": "Are you free this Saturday?", "ko": "이번 토요일에 시간 있어요?", "chunk": "are you free", "chunkKo": "시간 있어요?"},
  {"id": "d23", "set": "daily", "en": "I'm on my way.", "ko": "가는 중이에요.", "chunk": "on my way", "chunkKo": "가는 중인"},
  {"id": "d24", "set": "daily", "en": "Can you give me a hand?", "ko": "좀 도와줄래요?", "chunk": "give me a hand", "chunkKo": "도와주다"},
  {"id": "d25", "set": "daily", "en": "It was nice meeting you.", "ko": "만나서 반가웠어요.", "chunk": "nice meeting you", "chunkKo": "만나서 반가운"},
  {"id": "d26", "set": "daily", "en": "Could you speak a little louder?", "ko": "조금 크게 말씀해 주시겠어요?", "chunk": "a little louder", "chunkKo": "조금 더 크게"},
  {"id": "d27", "set": "daily", "en": "I'll have the same, please.", "ko": "저도 같은 걸로 할게요.", "chunk": "the same", "chunkKo": "같은 것"},
  {"id": "d28", "set": "daily", "en": "Do you have any plans tonight?", "ko": "오늘 밤에 계획 있어요?", "chunk": "plans tonight", "chunkKo": "오늘 밤 계획"},
  {"id": "d29", "set": "daily", "en": "Keep the change.", "ko": "잔돈은 가지세요.", "chunk": "keep the change", "chunkKo": "잔돈은 가지세요"},
  {"id": "d30", "set": "daily", "en": "Take care and get home safe.", "ko": "조심히 들어가요.", "chunk": "get home safe", "chunkKo": "무사히 집에 가다"}
]
